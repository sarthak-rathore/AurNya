# Copy to .env.local for local work; on Vercel add these under Settings > Environment Variables.
# Public values (safe in the browser):
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
# Database (server only, never prefix with NEXT_PUBLIC_). Leave empty to run on the built-in demo data.
# Neon: copy the POOLED connection string. Local Postgres also works, for example postgres://user:pass@localhost:5432/aurnya
DATABASE_URL=
# Optional, used only by `npm run db:migrate` (Neon: the NON-pooled string is best for schema changes). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: bag checks allowed per visitor per minute (default 60).
# QUOTE_RATE_LIMIT_PER_MIN=60
# Authentication (server only, Phase 4+):
JWT_SECRET=
# Phase 5: Payments (Razorpay) & Shipping & Emails:
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional Emails (Resend):
RESEND_API_KEY=
EMAIL_FROM="AurNya <orders@aurnya.com>"

# Phase 6 & Beyond: Admin / Owner / Manager Dashboards
# Three role levels:
# 1) OWNER (100% access - manage staff, toggle store controls, full database rights)
OWNER_EMAIL=owner@aurnya.com
OWNER_PASSWORD=AurNya@Owner2026
# 2) ADMIN (Full catalogue, orders, inventory, coupons, banners management)
ADMIN_EMAIL=admin@aurnya.com
ADMIN_PASSWORD=AurNya@Admin2026
# 3) MANAGER (Operational floor access - orders, products, inventory viewing)
MANAGER_EMAIL=manager@aurnya.com
MANAGER_PASSWORD=AurNya@Manager2026
# Secret for signing role sessions (falls back to JWT_SECRET)
ROLE_SESSION_SECRET=
ADMIN_SESSION_SECRET=
# Picture upload (cloudinary.com, free plan is fine). Without these you can still paste picture links or use files from /public/images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Daily clean-up of unpaid online orders (Vercel Cron, see vercel.json). Any long random text. Leave empty to switch the clean-up route off;
# unpaid orders are still released automatically whenever someone checks out or you open the dashboard.
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp updates to customers (Phase 7)
# Customers who sign in with a mobile number get order updates, sale alerts and
# exclusive offers on WhatsApp. This is the ONLY place you configure it.
# Leave everything below empty to keep WhatsApp switched off (nothing else breaks).
# Pick ONE provider. Step-by-step: README_PHASE_7_WHATSAPP_AND_APPROVALS.md
# ---------------------------------------------------------------------------
# Provider: meta (WhatsApp Cloud API, recommended) or twilio. Auto-detected from the keys below if left empty.
WHATSAPP_PROVIDER=

# Option A: Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any text you choose; the same text goes into Meta's webhook screen (lets customers reply STOP to unsubscribe).
WHATSAPP_VERIFY_TOKEN=
# Optional: your Meta app secret, to verify webhook calls really come from Meta.
WHATSAPP_APP_SECRET=
# "template" (default; needed to message customers first) or "text" (testing only: reaches people who messaged you in the last 24 hours).
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_WELCOME=aurnya_welcome
WHATSAPP_TEMPLATE_ORDER=aurnya_order_update
WHATSAPP_TEMPLATE_OFFER=aurnya_offer
WHATSAPP_TEMPLATE_SALE=aurnya_sale

# Option B: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (the sandbox number works for testing)
TWILIO_WHATSAPP_FROM=

# Both options
# Added in front of numbers customers type without a country code (91 = India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Name shown in the messages.
WHATSAPP_BRAND=AurNya
