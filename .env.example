# Copy to .env.local for local work; on Vercel add these under Settings > Environment Variables.
# Public values (safe in the browser):
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
# Database (server only, never prefix with NEXT_PUBLIC_). Leave empty to run on the built-in demo data.
# Neon: copy the POOLED connection string. Local Postgres also works, for example postgres://user:pass@localhost:5432/aurnya
DATABASE_URL=
# Optional, used only by `npm run db:migrate` (Neon: the NON-pooled string is best for schema changes). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: bag checks allowed per visitor per minute (default 60).
# QUOTE_RATE_LIMIT_PER_MIN=60
# Authentication (server only, Phase 4+):
JWT_SECRET=
# Phase 5: Payments (Razorpay) & Shipping & Emails:
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional Emails (Resend):
RESEND_API_KEY=
EMAIL_FROM="AurNya <orders@aurnya.com>"

# Phase 6: Admin dashboard (open it at /admin)
# Your own admin sign-in. Nobody can sign in with a normal customer account. The password needs at least 10 characters; use a long one.
# Changing ADMIN_PASSWORD signs everyone out of the dashboard. The dashboard also needs DATABASE_URL and JWT_SECRET (at least 16 random characters).
ADMIN_EMAIL=abcd@gmail.com
ADMIN_PASSWORD=1234567890
# Optional: a separate secret just for admin sessions. Falls back to JWT_SECRET.
ADMIN_SESSION_SECRET=
# Picture upload (cloudinary.com, free plan is fine). Without these you can still paste picture links or use files from /public/images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Daily clean-up of unpaid online orders (Vercel Cron, see vercel.json). Any long random text. Leave empty to switch the clean-up route off;
# unpaid orders are still released automatically whenever someone checks out or you open the dashboard.
CRON_SECRET=
