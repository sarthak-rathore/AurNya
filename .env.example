# Copy to .env.local for local work; on Vercel add these under Settings > Environment Variables.
# Public values (safe in the browser):
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
# Database (server only, never prefix with NEXT_PUBLIC_). Leave empty to run on the built-in demo data.
# Neon: copy the POOLED connection string. Local Postgres also works, for example postgres://user:pass@localhost:5432/aurnya
DATABASE_URL=
# Optional, used only by `npm run db:migrate` (Neon: the NON-pooled string is best for schema changes). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: bag checks allowed per visitor per minute (default 60).
# QUOTE_RATE_LIMIT_PER_MIN=60
# Authentication (server only, Phase 4+):
JWT_SECRET=
# Phase 5: Payments (Razorpay) & Shipping & Emails:
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Transactional Emails (Resend):
RESEND_API_KEY=
EMAIL_FROM="AurNya <orders@aurnya.com>"
