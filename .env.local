# =============================================================================
# AurNya Luxury Jewels — Complete Master Environment Configuration
# =============================================================================
# This is the SINGLE master environment file for the entire AurNya platform.
# It contains ALL 42+ configuration keys supported across all phases (Storefront,
# Neon Database, Auth Roles, Razorpay, Resend, Cloudinary, Meta WhatsApp, Twilio,
# Vercel Crons, and Rate Limiting).
#
# DEMO MODE vs PRODUCTION MODE:
#   Demo Mode:       NEXT_PUBLIC_DEMO_MODE=true  DEMO_MODE=true
#   Production Mode: NEXT_PUBLIC_DEMO_MODE=false DEMO_MODE=false + DATABASE_URL
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SITE IDENTITY & CANONICAL URLS
# -----------------------------------------------------------------------------
# Public canonical URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. DEMO / PRODUCTION MASTER CONTROLLER
# -----------------------------------------------------------------------------
# Set BOTH to "false" when deploying to production with real database.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true

# -----------------------------------------------------------------------------
# 3. PUBLIC LUXURY CONCIERGE & SOCIAL CHANNELS
# -----------------------------------------------------------------------------
# Displayed in Header, Footer, and Info contact pages.
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/aurnya
NEXT_PUBLIC_WHATSAPP=https://wa.me/918147349242
NEXT_PUBLIC_EMAIL=concierge@aurnya.com

# -----------------------------------------------------------------------------
# 4. DATABASE (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------------------
# Leave empty for demo mode (uses fast in-memory store).
# For production:
#   DATABASE_URL: Pooled connection string (with PgBouncer) for live traffic.
#   DATABASE_URL_UNPOOLED: Direct connection string for DDL schema migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# 5. AUTHENTICATION & ENCRYPTION SECRETS
# -----------------------------------------------------------------------------
# JWT secret for customer session tokens (openssl rand -base64 48)
JWT_SECRET=aurnya-dev-secret-local-testing-key-replace-in-production

# Secret for signing Owner, Admin, and Manager role cookies
ROLE_SESSION_SECRET=aurnya-role-session-secret-dev-2026-replace-in-production

# Fallback alias for legacy admin session signing (optional, falls back to ROLE_SESSION_SECRET)
ADMIN_SESSION_SECRET=

# Internal WASM directory (used during development / testing)
NEXT_TEST_WASM_DIR=./node_modules/@next/swc-wasm-nodejs

# -----------------------------------------------------------------------------
# 6. STAFF ROLES & CREDENTIALS
# -----------------------------------------------------------------------------
# 1) OWNER: Root access, financial analytics, staff management, store approvals
OWNER_EMAIL=owner@aurnya.com
OWNER_PASSWORD=AurNya@Owner2026

# 2) ADMIN: Catalogue, inventory, orders, marketing coupons, hero banners
ADMIN_EMAIL=admin@aurnya.com
ADMIN_PASSWORD=AurNya@Admin2026

# 3) MANAGER: Fulfillment operations, stock counts, order status updates
MANAGER_EMAIL=manager@aurnya.com
MANAGER_PASSWORD=AurNya@Manager2026

# -----------------------------------------------------------------------------
# 7. PAYMENTS (Razorpay)
# -----------------------------------------------------------------------------
# Client-side public key (loaded by checkout modal):
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-side key ID (backend alias, defaults to NEXT_PUBLIC_RAZORPAY_KEY_ID if blank):
RAZORPAY_KEY_ID=

# Private merchant secret:
RAZORPAY_KEY_SECRET=

# Webhook signature secret (from Razorpay Dashboard > Webhooks):
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 8. TRANSACTIONAL EMAILS & OTP DISPATCH (Resend)
# -----------------------------------------------------------------------------
# Resend API key (starts with re_):
RESEND_API_KEY=

# Verified sender address:
EMAIL_FROM=AurNya Concierge <concierge@aurnya.com>

# -----------------------------------------------------------------------------
# 9. MEDIA & JEWELLERY PHOTOGRAPHY CDN (Cloudinary)
# -----------------------------------------------------------------------------
# Cloudinary account credentials:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Unsigned upload preset for direct product image uploads:
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=aurnya_products

# -----------------------------------------------------------------------------
# 10. BACKGROUND AUTOMATION & CRONS
# -----------------------------------------------------------------------------
# Secret token to protect daily cleanup of unpaid online orders (Vercel Cron).
# Any long random string. Leave empty to disable route protection.
CRON_SECRET=

# Optional rate limit: maximum cart price quotes allowed per visitor per minute (default: 60)
QUOTE_RATE_LIMIT_PER_MIN=60

# -----------------------------------------------------------------------------
# 11. WHATSAPP CUSTOMER MESSAGING (Phase 7)
# -----------------------------------------------------------------------------
# Customers who provide a mobile number get order notifications, dispatch
# alerts, and sale announcements on WhatsApp.
# Provider selection: "meta" (recommended) or "twilio". Auto-detected if left empty.
WHATSAPP_PROVIDER=

# --- Option A: Meta WhatsApp Cloud API (Recommended) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aurnya-whatsapp-webhook-token-2026
WHATSAPP_APP_SECRET=

# Messaging mode: "template" (default, needed to message customers first)
# or "text" (testing only: reaches users who messaged you in the last 24 hours).
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_WELCOME=aurnya_welcome
WHATSAPP_TEMPLATE_ORDER=aurnya_order_update
WHATSAPP_TEMPLATE_OFFER=aurnya_offer
WHATSAPP_TEMPLATE_SALE=aurnya_sale

# --- Option B: Twilio WhatsApp (Alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Common WhatsApp Settings (Applies to both providers) ---
# Default country dial code prepended if user omits it (91 = India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Brand name displayed in notifications
WHATSAPP_BRAND=AurNya
